		<HBAOSettings>
			<Enabled>true</Enabled>
			<Radius>3.2</Radius>
			<Bias>0.110</Bias>
			<SmallScaleAO>0.8</SmallScaleAO>
			<LargeScaleAO>1.2</LargeScaleAO>
			<PowerExponent>2.5</PowerExponent>
			<ForegroundAOEnable>true</ForegroundAOEnable>
			<ForegroundViewDepth>5</ForegroundViewDepth>
			<BackgroundAOEnable>true</BackgroundAOEnable>
			<BackgroundViewDepth>25</BackgroundViewDepth>
			<DepthClampToEdge>true</DepthClampToEdge>
			<DepthThresholdEnable>false</DepthThresholdEnable>
			<DepthThreshold>500</DepthThreshold>
			<DepthThresholdSharpness>255</DepthThresholdSharpness>
			<BlurEnable>true</BlurEnable>
			<BlurRadius4>false</BlurRadius4>
			<BlurSharpness>100.0</BlurSharpness>
			<BlurSharpnessFunctionEnable>true</BlurSharpnessFunctionEnable>
			<BlurSharpnessFunctionForegroundScale>50.0</BlurSharpnessFunctionForegroundScale>
			<BlurSharpnessFunctionForegroundViewDepth>0</BlurSharpnessFunctionForegroundViewDepth>
			<BlurSharpnessFunctionBackgroundViewDepth>1.0</BlurSharpnessFunctionBackgroundViewDepth>
		</HBAOSettings>
		<EnvironmentTexture>Textures\BackgroundCube\Final\Xylanthia_2048.dds</EnvironmentTexture>
		<!-- Vanilla values (Keen Environment.sbc): ShadowSettings, LowLoddingSettings, MediumLoddingSettings, HighLoddingSettings, ExtremeLoddingSettings, SSAOSettings -->
		<ShadowSettings>
			<Data>
				<ShowShadowCascadeSplits>false</ShowShadowCascadeSplits>
				<UpdateCascadesEveryFrame>false</UpdateCascadesEveryFrame>
				<EnableShadowBlur>true</EnableShadowBlur>
				<ShadowCascadeMaxDistance>3000</ShadowCascadeMaxDistance>
				<ShadowCascadeMaxDistanceMultiplierMedium>5</ShadowCascadeMaxDistanceMultiplierMedium>
				<ShadowCascadeMaxDistanceMultiplierHigh>9</ShadowCascadeMaxDistanceMultiplierHigh>
				<ShadowCascadeMaxDistanceMultiplierExtreme>10</ShadowCascadeMaxDistanceMultiplierExtreme>
				<ShadowCascadeSpreadFactor>0</ShadowCascadeSpreadFactor>
				<ShadowCascadeZOffset>40000</ShadowCascadeZOffset>
				<LightDirectionChangeDelayMultiplier>18</LightDirectionChangeDelayMultiplier>
				<DisplayFrozenShadowCascade>false</DisplayFrozenShadowCascade>
				<ReflectorShadowDistanceLow>0</ReflectorShadowDistanceLow>
				<ReflectorShadowDistanceMedium>0.4</ReflectorShadowDistanceMedium>
				<ReflectorShadowDistanceHigh>1.0</ReflectorShadowDistanceHigh>
				<ReflectorShadowDistanceExtreme>1.0</ReflectorShadowDistanceExtreme>
				<LightDirectionDifferenceThreshold>0.0175</LightDirectionDifferenceThreshold>
				<ZBias>0.01</ZBias>
				<CascadesCount>6</CascadesCount>
			</Data>
		</ShadowSettings>
		<LowLoddingSettings>
			<!-- lodding selection is set here -->
			<GBuffer>
				<LodShift>0</LodShift>
				<MinLod>1</MinLod>
			</GBuffer>
			<CascadeDepths>
				<CascadeDepth>
					<!-- shadow cascade num. 0 -->
					<LodShiftVisible>1</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 1 -->
					<LodShiftVisible>1</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 2 -->
					<LodShiftVisible>1</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 3 -->
					<LodShiftVisible>3</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 4 -->
					<LodShiftVisible>3</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 5 -->
					<LodShiftVisible>3</LodShiftVisible>
					<LodShift>3</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
			</CascadeDepths>
			<SingleDepth>
				<LodShiftVisible>1</LodShiftVisible>
				<LodShift>3</LodShift>
				<MinLod>1</MinLod>
			</SingleDepth>
			<Forward>
				<LodShiftVisible>10</LodShiftVisible>
				<LodShift>10</LodShift>
				<MinLod>10</MinLod>
			</Forward>
			<Global>
				<ObjectDistanceAdd>0</ObjectDistanceAdd>
				<ObjectDistanceMult>4</ObjectDistanceMult>
				<MinTransitionInSeconds>0.2</MinTransitionInSeconds>
				<MaxTransitionInSeconds>0.4</MaxTransitionInSeconds>
				<TransitionDeadZoneConst>2.0</TransitionDeadZoneConst>
				<TransitionDeadZoneDistanceMult>0.5</TransitionDeadZoneDistanceMult>
				<IsUpdateEnabled>true</IsUpdateEnabled>
				<MaxDistanceForSmoothCameraMovement>11</MaxDistanceForSmoothCameraMovement>
				<!--- if this value of units per frame is reached, the lods are skipped (no transition) -->
				<HisteresisRatio>0.1</HisteresisRatio>
			</Global>
		</LowLoddingSettings>
		<MediumLoddingSettings>
			<!-- lodding selection is set here -->
			<GBuffer>
				<LodShift>0</LodShift>
				<MinLod>1</MinLod>
			</GBuffer>
			<CascadeDepths>
				<CascadeDepth>
					<!-- shadow cascade num. 0 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 1 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 2 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 3 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 4 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 5 -->
					<LodShift>2</LodShift>
					<MinLod>1</MinLod>
				</CascadeDepth>
			</CascadeDepths>
			<SingleDepth>
				<LodShift>2</LodShift>
				<MinLod>1</MinLod>
			</SingleDepth>
			<Forward>
				<LodShiftVisible>10</LodShiftVisible>
				<LodShift>10</LodShift>
				<MinLod>10</MinLod>
			</Forward>
			<Global>
				<ObjectDistanceAdd>-5</ObjectDistanceAdd>
				<ObjectDistanceMult>2</ObjectDistanceMult>
				<MinTransitionInSeconds>0.2</MinTransitionInSeconds>
				<MaxTransitionInSeconds>0.4</MaxTransitionInSeconds>
				<TransitionDeadZoneConst>2.0</TransitionDeadZoneConst>
				<TransitionDeadZoneDistanceMult>0.5</TransitionDeadZoneDistanceMult>
				<IsUpdateEnabled>true</IsUpdateEnabled>
				<MaxDistanceForSmoothCameraMovement>11</MaxDistanceForSmoothCameraMovement>
				<!--- if this value of units per frame is reached, the lods are skipped (no transition) -->
				<HisteresisRatio>0.1</HisteresisRatio>
			</Global>
		</MediumLoddingSettings>
		<HighLoddingSettings>
			<!-- lodding selection is set here -->
			<GBuffer>
				<LodShift>0</LodShift>
				<MinLod>0</MinLod>
			</GBuffer>
			<CascadeDepths>
				<CascadeDepth>
					<!-- shadow cascade num. 0 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 1 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 2 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 3 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 4 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 5 -->
					<LodShift>2</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
			</CascadeDepths>
			<SingleDepth>
				<LodShift>2</LodShift>
				<MinLod>0</MinLod>
			</SingleDepth>
			<Forward>
				<LodShiftVisible>10</LodShiftVisible>
				<LodShift>10</LodShift>
				<MinLod>10</MinLod>
			</Forward>
			<Global>
				<ObjectDistanceAdd>0</ObjectDistanceAdd>
				<ObjectDistanceMult>1</ObjectDistanceMult>
				<MinTransitionInSeconds>0.25</MinTransitionInSeconds>
				<MaxTransitionInSeconds>1</MaxTransitionInSeconds>
				<TransitionDeadZoneConst>2.0</TransitionDeadZoneConst>
				<TransitionDeadZoneDistanceMult>0.5</TransitionDeadZoneDistanceMult>
				<IsUpdateEnabled>true</IsUpdateEnabled>
				<MaxDistanceForSmoothCameraMovement>11</MaxDistanceForSmoothCameraMovement>
				<!--- if this value of units per frame is reached, the lods are skipped (no transition) -->
