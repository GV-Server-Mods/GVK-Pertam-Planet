		<ExtremeLoddingSettings>
			<!-- lodding selection is set here -->
			<GBuffer>
				<LodShift>0</LodShift>
				<MinLod>0</MinLod>
			</GBuffer>
			<CascadeDepths>
				<CascadeDepth>
					<!-- shadow cascade num. 0 -->
					<LodShift>0</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 1 -->
					<LodShift>0</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 2 -->
					<LodShift>0</LodShift>
					<MinLod>0</MinLod>
				</CascadeDepth>
				<CascadeDepth>
					<!-- shadow cascade num. 3 -->
					<LodShift>0</LodShift>
