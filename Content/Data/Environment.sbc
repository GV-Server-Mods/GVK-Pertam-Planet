		<SunProperties>
			<SunIntensity>200</SunIntensity>
			<EnvironmentProbe>
				<TimeOut>0.3</TimeOut>
				<DrawDistance>2000</DrawDistance>
				<AmbientScale>0.1</AmbientScale>
				<AmbientMinClamp>0.02</AmbientMinClamp>
				<AmbientMaxClamp>0.3</AmbientMaxClamp>
			</EnvironmentProbe>
			<EnvironmentLight>
				<SunColor>
					<X>1</X>
					<Y>1</Y>
					<Z>1</Z>
				</SunColor>
				<SunDiffuseFactor>1.0</SunDiffuseFactor>
				<SunGlossFactor>1.0</SunGlossFactor>
				<AmbientDiffuseFactor>1</AmbientDiffuseFactor>
				<AmbientSpecularFactor>5</AmbientSpecularFactor>
				<GlassAmbient>0</GlassAmbient>
				<AmbientForwardPass>0.0</AmbientForwardPass>
				<AmbientGlobalMinimum>0</AmbientGlobalMinimum>
				<AmbientGlobalDensity>0</AmbientGlobalDensity>
				<AmbientGlobalMultiplier>0</AmbientGlobalMultiplier>
				<SunDiscColor>
					<X>1.0</X>
					<Y>0.48</Y>
					<Z>0.08</Z>
				</SunDiscColor>
				<SunDiscColor2>
					<X>1.0</X>
					<Y>1.0</Y>
					<Z>1.0</Z>
				</SunDiscColor2>
				<SunDiscInnerDot>0.999</SunDiscInnerDot>
				<SunDiscOuterDot>0.9987</SunDiscOuterDot>
				<AODirLight>1</AODirLight>
				<AOIndirectLight>1</AOIndirectLight>
				<AOPointLight>0.7</AOPointLight>
				<AOSpotLight>0.7</AOSpotLight>
				<SkyboxBrightness>0.5</SkyboxBrightness>
				<EnvSkyboxBrightness>2.5</EnvSkyboxBrightness>
				<ShadowFadeoutMultiplier>0.0</ShadowFadeoutMultiplier>
				<EnvShadowFadeoutMultiplier>0</EnvShadowFadeoutMultiplier>
				<EnvAtmosphereBrightness>1.0</EnvAtmosphereBrightness>
				<AmbientRadius>50.0</AmbientRadius>
				<AmbientLightsGatherRadius>15.0</AmbientLightsGatherRadius>
				<SunDiscIntensity>3.8</SunDiscIntensity>
			</EnvironmentLight>
			<TextureMultipliers>
				<GlossMultiplier>1.0</GlossMultiplier>
			</TextureMultipliers>
		</SunProperties>
		<PostProcessSettings>
			<EnableTonemapping>true</EnableTonemapping>
			<EnableEyeAdaptation>true</EnableEyeAdaptation>
			<HighQualityBloom>true</HighQualityBloom>
			<BloomAntiFlickerFilter>true</BloomAntiFlickerFilter>
			<BloomSize>4</BloomSize>
			<HistogramLogMin>-4</HistogramLogMin>
			<HistogramLogMax>4</HistogramLogMax>
			<HistogramFilterMin>70</HistogramFilterMin>
			<HistogramFilterMax>95</HistogramFilterMax>
			<HistogramSkyboxFactor>0.25</HistogramSkyboxFactor>
			<MinEyeAdaptationLogBrightness>-2.5</MinEyeAdaptationLogBrightness>
			<MaxEyeAdaptationLogBrightness>2.5</MaxEyeAdaptationLogBrightness>
			<DirtTexture>Textures\SunGlare\Dirt.dds</DirtTexture>
			<ChromaticIterations>0</ChromaticIterations>
			<EyeAdaptationPrioritizeScreenCenter>false</EyeAdaptationPrioritizeScreenCenter>
			<Data>
				<Contrast>1.0</Contrast>
				<Brightness>1</Brightness>
				<Saturation>1.1</Saturation>
				<BrightnessFactorR>1</BrightnessFactorR>
				<BrightnessFactorG>1</BrightnessFactorG>
				<BrightnessFactorB>1</BrightnessFactorB>
				<LightColor>
					<X>1</X>
					<Y>0.9</Y>
					<Z>0.5</Z>
				</LightColor>
				<DarkColor>
					<X>0.2</X>
					<Y>0.05</Y>
					<Z>0</Z>
				</DarkColor>
				<ConstantLuminance>0.1</ConstantLuminance>
				<LuminanceExposure>0.0</LuminanceExposure>
				<EyeAdaptationTau>2.4</EyeAdaptationTau>
				<BloomExposure>5.04930735</BloomExposure>
				<BloomLumaThreshold>5.0</BloomLumaThreshold>
				<BloomMult>0.02</BloomMult>
				<BloomEmissiveness>120</BloomEmissiveness>
				<BloomDepthStrength>2.0</BloomDepthStrength>
				<BloomDepthSlope>0.3</BloomDepthSlope>
				<LogLumThreshold>-6</LogLumThreshold>
				<EyeAdaptationSpeedUp>2</EyeAdaptationSpeedUp>
				<EyeAdaptationSpeedDown>1</EyeAdaptationSpeedDown>
				<WhitePoint>11.2</WhitePoint>
				<BloomDirtRatio>0</BloomDirtRatio>
				<GrainSize>0</GrainSize>
				<GrainAmount>0</GrainAmount>
				<GrainStrength>0.0</GrainStrength>
				<ChromaticFactor>0</ChromaticFactor>
				<Vibrance>0.5</Vibrance>
				<VignetteStart>0</VignetteStart>
				<VignetteLength>0</VignetteLength>
			</Data>
		</PostProcessSettings>
