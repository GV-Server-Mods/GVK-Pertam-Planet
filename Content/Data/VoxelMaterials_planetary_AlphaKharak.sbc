<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<VoxelMaterials>
		<!-- Pertam Kharak Sand that yeilds new "Nothing" item -->
		<VoxelMaterial xsi:type="MyObjectBuilder_Dx11VoxelMaterialDefinition">
			<Id>
				<TypeId>VoxelMaterialDefinition</TypeId>
				<SubtypeId>Sand_Kharak_2</SubtypeId>
			</Id>
			<SpawnsInAsteroids>false</SpawnsInAsteroids>
			<SpawnsFromMeteorites>false</SpawnsFromMeteorites>
			<MaterialTypeName>Sand</MaterialTypeName>
			<MinedOre>Nothing</MinedOre>
			<MinedOreRatio>0</MinedOreRatio>
			<CanBeHarvested>false</CanBeHarvested>
			<IsRare>false</IsRare>
			<IsIndestructible>false</IsIndestructible>
			<DamageRatio>1</DamageRatio>
			<ParticleEffect>Collision_Meteor</ParticleEffect>
			<VoxelHandPreview>Textures\Voxels\Pertam\PertamSand_Thumbnail.dds</VoxelHandPreview>
			<ColorMetalXZnY>Textures\Voxels\Pertam\PertamSand_cm.dds</ColorMetalXZnY>
			<NormalGlossXZnY>Textures\Voxels\Pertam\PertamSand_ng.dds</NormalGlossXZnY>
			<ExtXZnY>Textures\Voxels\Pertam\PertamSand_add.dds</ExtXZnY>
			<ColorMetalXZnYFar1>Textures\Voxels\Pertam\PertamSand_cm.dds</ColorMetalXZnYFar1>
			<NormalGlossXZnYFar1>Textures\Voxels\Pertam\PertamSand_ng.dds</NormalGlossXZnYFar1>
			<ExtXZnYFar1>Textures\Voxels\Pertam\PertamSand_add.dds</ExtXZnYFar1>
			<ColorMetalXZnYFar2>Textures\Voxels\Pertam\PertamSand_cm.dds</ColorMetalXZnYFar2>
			<NormalGlossXZnYFar2>Textures\Voxels\Pertam\PertamSand_ng.dds</NormalGlossXZnYFar2>
			<ExtXZnYFar2>Textures\Voxels\Pertam\PertamSand_add.dds</ExtXZnYFar2>
			<SpecularPower>24</SpecularPower>
			<SpecularShininess>0.364</SpecularShininess>
			<ColorKey Hex="#823317"/>
			<SimpleTilingSetup>
				<InitialScale>4</InitialScale>
				<ScaleMultiplier>8</ScaleMultiplier>
				<InitialDistance>4</InitialDistance>
				<ExtDetailScale>0.005</ExtDetailScale>
				<Scale>500</Scale>
				<Far1Distance>22</Far1Distance>
				<Far2Distance>500</Far2Distance>
				<Far1Scale>60</Far1Scale>
				<Far2Scale>200</Far2Scale>
				<Far3Distance>50000</Far3Distance>
			</SimpleTilingSetup>
			<InitialScale>2</InitialScale>
			<ScaleMultiplier>4</ScaleMultiplier>
			<InitialDistance>20</InitialDistance>
			<DistanceMultiplier>2</DistanceMultiplier>
			<TilingScale>20</TilingScale>
			<ExtDetailScale>0.005</ExtDetailScale>
			<Scale>2</Scale>
			<Far1Distance>50</Far1Distance>
			<Far2Distance>500</Far2Distance>
			<Far1Scale>60</Far1Scale>
			<Far2Scale>200</Far2Scale>
			<Far3Distance>50000</Far3Distance>
			<Far3Color>
				<X>0.85</X>
				<Y>0.50</Y>
				<Z>0.30</Z>
				<W>1.0</W>
			</Far3Color>
			<FoliageDensity>1</FoliageDensity>
			<FoliageScale>
				<X>0.2</X>
				<Y>0.2</Y>
			</FoliageScale>
			<FoliageRandomRescaleMult>0.5</FoliageRandomRescaleMult>
			<FoliageType>1</FoliageType>
			<Friction>0.7</Friction>
			<Restitution>0.3</Restitution>
			<LandingEffect>Landing_Jet_Grid_KharakSand</LandingEffect>
		</VoxelMaterial>
		<!-- Road material that yeids Nothing Converted to soil-like for Pertam-->
		<VoxelMaterial xsi:type="MyObjectBuilder_Dx11VoxelMaterialDefinition">
			<Id>
				<TypeId>VoxelMaterialDefinition</TypeId>
				<SubtypeId>Stone_03_Roads</SubtypeId>
			</Id>
			<SpawnsInAsteroids>false</SpawnsInAsteroids>
			<SpawnsFromMeteorites>false</SpawnsFromMeteorites>
			<MaterialTypeName>Rock</MaterialTypeName> <!-- or Soil if Rock isn't providing engine wheel sounds -->
			<MinedOre>Nothing</MinedOre>
			<IsIndestructible>true</IsIndestructible>
			<MinedOreRatio>0</MinedOreRatio>
			<CanBeHarvested>false</CanBeHarvested>
			<IsRare>false</IsRare>
			<DamageRatio>0.0001</DamageRatio>
			<ParticleEffect>Collision_Meteor</ParticleEffect>
			<VoxelHandPreview>Textures\Voxels\Soil_Thumbnail.dds</VoxelHandPreview>
			<ColorMetalXZnY>Textures\Voxels\DirtRoad_cm.dds</ColorMetalXZnY>
			<NormalGlossXZnY>Textures\Voxels\Soil_Far1_ng.dds</NormalGlossXZnY>
			<ExtXZnY>Textures\Voxels\Dummy_add.dds</ExtXZnY>
			<ColorMetalXZnYFar1>Textures\Voxels\DirtRoad_cm.dds</ColorMetalXZnYFar1>
			<NormalGlossXZnYFar1>Textures\Voxels\Soil_Far2_ng.dds</NormalGlossXZnYFar1>
			<ExtXZnYFar1>Textures\Voxels\Dummy_add.dds</ExtXZnYFar1>
			<ColorMetalXZnYFar2>Textures\Voxels\DirtRoad_cm.dds</ColorMetalXZnYFar2>
			<NormalGlossXZnYFar2>Textures\Voxels\Soil_Far2_ng.dds</NormalGlossXZnYFar2>
			<ExtXZnYFar2>Textures\Voxels\Dummy_add.dds</ExtXZnYFar2>
			<SimpleTilingSetup>
				<ExtDetailScale>0.005</ExtDetailScale>
				<Scale>2</Scale>
				<Far1Distance>30</Far1Distance>
				<Far2Distance>500</Far2Distance>
				<Far1Scale>200</Far1Scale>
				<Far2Scale>1000</Far2Scale>
				<Far3Distance>5000</Far3Distance>
			</SimpleTilingSetup>
			<ExtDetailScale>0.005</ExtDetailScale>
			<Scale>2</Scale>
			<ScaleMultiplier>8</ScaleMultiplier>
			<Far1Distance>30</Far1Distance>
			<Far2Distance>500</Far2Distance>
			<Far1Scale>200</Far1Scale>
			<Far2Scale>1000</Far2Scale>
			<TilingScale>32</TilingScale>
			<Far3Distance>5000</Far3Distance>
			<Far3Color>
				<X>0.13</X>
				<Y>0.10</Y>
				<Z>0.05</Z>
				<W>1.0</W>
			</Far3Color>
			<FoliageDensity>0</FoliageDensity>
			<FoliageScale>
				<X>0.7</X>
				<Y>0.7</Y>
			</FoliageScale>
			<FoliageRandomRescaleMult>0.1</FoliageRandomRescaleMult>
			<FoliageType>1</FoliageType>
			<ColorKey Hex="#BCBB56"/>
			<Friction>1</Friction>
			<Restitution>0.7</Restitution>
			<LandingEffect>Landing_Jet_Ground_Dust</LandingEffect>
		</VoxelMaterial>
	</VoxelMaterials>
</Definitions>
