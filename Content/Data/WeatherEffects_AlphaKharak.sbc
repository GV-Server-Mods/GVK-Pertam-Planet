		<WeatherEffect xsi:type="MyObjectBuilder_WeatherEffectDefinition"> <!-- Kharak Hailstorm: vanilla, milder damage -->
            <Id>
                <TypeId>WeatherEffectDefinition</TypeId>
                <SubtypeId>Hailstorm</SubtypeId>
            </Id>
			<DisplayName>DisplayName_TSS_Weather_Hailstorm</DisplayName>
			<FogColor>
				<X>0.81</X>
				<Y>0.81</Y>
				<Z>0.81</Z>
		    </FogColor>
            <FogDensity>0.005</FogDensity>
            <FogMultiplier>0.5</FogMultiplier>
			<FogSkyboxMultiplier>1</FogSkyboxMultiplier>
            <FogAtmoMultiplier>1</FogAtmoMultiplier>
			<AmbientSound>WM_Hailstorm</AmbientSound>
            <AmbientVolume>0.5</AmbientVolume>
            <EffectName>WM_Hailstorm</EffectName>
            <ParticleRadius>150</ParticleRadius>
            <ParticleCount>10</ParticleCount>
			<ParticleScale>1.1</ParticleScale>
			<LightningIntervalMin>0</LightningIntervalMin>
			<LightningIntervalMax>0</LightningIntervalMax>
			<LightningCharacterHitIntervalMin>0</LightningCharacterHitIntervalMin>
			<LightningCharacterHitIntervalMax>0</LightningCharacterHitIntervalMax>
			<LightningGridHitIntervalMin>0</LightningGridHitIntervalMin>
			<LightningGridHitIntervalMax>0</LightningGridHitIntervalMax>			
			<WindOutputModifier>2</WindOutputModifier>
			<SolarOutputModifier>0.25</SolarOutputModifier>
			<TemperatureModifier>0.1</TemperatureModifier>
			<OxygenLevelModifier>1</OxygenLevelModifier>
			<FoliageWindModifier>2</FoliageWindModifier>
			<ParticleAlphaMultiplier>10</ParticleAlphaMultiplier>
			<SunColor>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</SunColor>
			<SunSpecularColor>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</SunSpecularColor>
			<SunIntensity>3</SunIntensity>
			<ShadowFadeout>0.1</ShadowFadeout>
            <HealthHazard>
                <MinWeatherIntensity>0.5</MinWeatherIntensity>
                <DamageIntervalMin>30</DamageIntervalMin>
                <DamageIntervalMax>120</DamageIntervalMax>
                <DamageAmountMin>5</DamageAmountMin>
                <DamageAmountMax>10</DamageAmountMax>
            </HealthHazard>
            <HazardNotification>
                <Text>Notification_WeatherDamage_HailImpact</Text>
                <Font>Red</Font>
                <Duration>5</Duration>
                <Cooldown>10</Cooldown>
            </HazardNotification>
