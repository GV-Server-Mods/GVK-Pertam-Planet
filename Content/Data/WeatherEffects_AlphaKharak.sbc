<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<WeatherEffects>
		<WeatherEffect xsi:type="MyObjectBuilder_WeatherEffectDefinition">
			<Id>
				<TypeId>WeatherEffectDefinition</TypeId>
				<SubtypeId>RadiationStorm</SubtypeId>
			</Id>
			<DisplayName>Radiation Storm</DisplayName>
			<FogColor>
				<!-- range 0.0 to 1.0-->
				<X>0.5</X>
				<Y>0</Y>
				<Z>0.1</Z>
			</FogColor>
			<FogDensity>0.0075</FogDensity>
			<FogMultiplier>0.97</FogMultiplier>
			<FogSkyboxMultiplier>0.95</FogSkyboxMultiplier>
			<FogAtmoMultiplier>1</FogAtmoMultiplier>
			<AmbientSound>WM_Galados_V_RadStorm</AmbientSound>
			<AmbientVolume>0.5</AmbientVolume>
			<EffectName>WM_SnowSlow</EffectName>
			<ParticleRadius>125</ParticleRadius>
			<ParticleCount>5</ParticleCount>
			<ParticleScale>0.2</ParticleScale>
			<FoliageWindModifier>0.1</FoliageWindModifier>
			<LightningIntervalMin>0</LightningIntervalMin>
			<LightningIntervalMax>7</LightningIntervalMax>
			<LightningCharacterHitIntervalMin>240</LightningCharacterHitIntervalMin>
			<LightningCharacterHitIntervalMax>300</LightningCharacterHitIntervalMax>
			<LightningGridHitIntervalMin>240</LightningGridHitIntervalMin>
			<LightningGridHitIntervalMax>300</LightningGridHitIntervalMax>
			<LightningRodSafetyRadius/>
			<Lightning>
				<MaxLife>10</MaxLife>
				<BoltLength>4000</BoltLength>
				<BoltParts>250</BoltParts>
				<BoltVariation>200</BoltVariation>
				<BoltRadius>40</BoltRadius>
				<Damage>0</Damage>
				<Sound>WM_Lightning</Sound>
				<Color>
					<X>100</X>
					<Y>80</Y>
					<Z>40</Z>
					<W>1000</W>
				</Color>
				<ExplosionRadius>20</ExplosionRadius>
			</Lightning>
			<WindOutputModifier>0.1</WindOutputModifier>
			<SolarOutputModifier>0.25</SolarOutputModifier>
			<TemperatureModifier>0.5</TemperatureModifier>
			<OxygenLevelModifier>0.3</OxygenLevelModifier>
			<FoliageWindModifier>0.1</FoliageWindModifier>
			<ParticleAlphaMultiplier>0.75</ParticleAlphaMultiplier>
			<SunColor>
				<!-- range 0.0 to 1.0-->
				<X>1</X>
				<Y>0.2</Y>
				<Z>0.2</Z>
			</SunColor>
			<SunSpecularColor>
				<!-- range 0.0 to 1.0-->
				<X>1</X>
				<Y>0.3</Y>
				<Z>0.3</Z>
			</SunSpecularColor>
			<SunIntensity>10</SunIntensity>
			<ShadowFadeout>0</ShadowFadeout>
            <RadiationHazard>
                <MinWeatherIntensity>0.35</MinWeatherIntensity>
                <RadiationGain>0.3</RadiationGain>
            </RadiationHazard>
		</WeatherEffect>
