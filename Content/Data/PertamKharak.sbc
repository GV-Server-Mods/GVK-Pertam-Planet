		<MaximumOxygen>1.0</MaximumOxygen>
		<SurfaceGravity>1</SurfaceGravity>
		<DefaultSurfaceMaterial Material="Sand_Kharak_2" MaxDepth="10"/>
		<DefaultSubSurfaceMaterial Material="Stone"/>
		<AllowMeteors>false</AllowMeteors>
		<AllowContractSpawns>false</AllowContractSpawns>
		<AllowSurfaceEconomyStations>false</AllowSurfaceEconomyStations>
		<AllowOrbitalEconomyStations>false</AllowOrbitalEconomyStations>
		<SolarRadiationProtectionFactor>1</SolarRadiationProtectionFactor>
		<HasAtmosphere>true</HasAtmosphere>
		<DefaultSurfaceTemperature>Cozy</DefaultSurfaceTemperature>
		<!-- 	ExtremeFreeze,
				Freeze,
				Cozy,
				Hot,
				ExtremeHot
		-->
		<Atmosphere>
			<Breathable>true</Breathable>
			<OxygenDensity>1</OxygenDensity>
			<Density>1</Density>
			<LimitAltitude>3</LimitAltitude>
			<MaxWindSpeed>150</MaxWindSpeed>
		</Atmosphere>
		<!-- Earthlike Planet's Atmosphere settings -->
		<AtmosphereSettings>
			<RayleighScattering>
				<X>100</X>
				<Y>47.788</Y>
				<Z>17.684</Z>
			</RayleighScattering>
			<MieScattering>50</MieScattering>
			<MieColorScattering>
				<X>150</X>
				<Y>6.001</Y>
				<Z>5</Z>
			</MieColorScattering>
			<RayleighHeight>50</RayleighHeight>
			<RayleighHeightSpace>11.422</RayleighHeightSpace>
			<RayleighTransitionModifier>0.65</RayleighTransitionModifier>
			<MieHeight>195.983</MieHeight>
			<MieG>1</MieG>
			<Intensity>34.884</Intensity>
			<SeaLevelModifier>0.938</SeaLevelModifier>
			<AtmosphereTopModifier>1.1</AtmosphereTopModifier>
			<FogIntensity>0.15</FogIntensity>
			<Scale>1</Scale>
			<SunColor>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</SunColor>
			<SunSpecularColor>
				<X>1</X>
				<Y>1</Y>
				<Z>1</Z>
			</SunSpecularColor>
		</AtmosphereSettings>
		<!-- Earthlike Planet's Clouds settings-->
		<CloudLayers>
			<CloudLayer>
				<!-- Far layer -->
				<Model>Models/Environment/Sky/CloudSphere.mwm</Model>
				<Textures>
					<Texture>Textures/Models/Environment/Sky/Landsky_texture.dds</Texture>
				</Textures>
				<RelativeAltitude>0.9</RelativeAltitude>
				<RotationAxis>
					<X>-0.2</X>
					<Y>1</Y>
					<Z>0.2</Z>
				</RotationAxis>
				<AngularVelocity>0.0002</AngularVelocity>
				<InitialRotation>1.2</InitialRotation>
				<ScalingEnabled>false</ScalingEnabled>
				<FadeOutRelativeAltitudeStart>2.0</FadeOutRelativeAltitudeStart>
				<FadeOutRelativeAltitudeEnd>1.4</FadeOutRelativeAltitudeEnd>
				<ApplyFogRelativeDistance>0.05</ApplyFogRelativeDistance>
			</CloudLayer>
