			<SoundRule>
				<Height Min="0" Max="0.6"/>
				<Latitude Min="0" Max="90"/>
				<SunAngleFromZenith Min="0" Max="90"/>
				<EnvironmentSound>AmbDesertDay</EnvironmentSound>
			</SoundRule>
			<SoundRule>
				<Height Min="0" Max="0.6"/>
				<Latitude Min="0" Max="90"/>
				<SunAngleFromZenith Min="90" Max="180"/>
