					</Layers>
					<Height Min="0" Max="1"/>
					<Latitude Min="0" Max="90"/>
					<Slope Min="35" Max="90"/>
				</Rule>
			</MaterialGroup>
			<MaterialGroup Name="RocksTop" Value="94">
				<Rule>
					<Layers>
						<Layer Material="Snow" Depth="0.5"/>
						<Layer Material="DesertRocks" Depth="10"/>
					</Layers>
					<Height Min="0.65" Max="1"/>
					<Latitude Min="68" Max="90"/>
					<Slope Min="0" Max="45"/>
				</Rule>
				<Rule>
					<Layers>
						<Layer Material="DustyRocks" Depth="10"/>
					</Layers>
					<Height Min="0" Max="1"/>
					<Latitude Min="0" Max="90"/>
					<Slope Min="0" Max="90"/>
				</Rule>
			</MaterialGroup>
